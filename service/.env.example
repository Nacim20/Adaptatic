# Copie en .env (jamais commité) ou fournis ces variables à ton orchestrateur.
SUPABASE_URL=https://<ton-projet>.supabase.co
# Clé service_role : contourne la RLS. Serveur uniquement, ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=
# Même valeur que 'webhook_secret' dans private.app_config (voir supabase/config.example.sql)
WEBHOOK_SECRET=
PORT=8080
# Clé publishable (sb_publishable_…) : sert à valider le jeton de l'utilisateur pour le scan de code-barres.
SUPABASE_PUBLISHABLE_KEY=
# Identifie l'app auprès d'Open Food Facts (obligatoire de leur côté) : mets un contact réel.
OFF_USER_AGENT=Adaptatic/0.1 (https://github.com/Nacim20/Adaptatic)
# Origines autorisées pour l'app web (CORS). '*' en développement.
CORS_ORIGINS=*
