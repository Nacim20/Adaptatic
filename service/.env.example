# Copie en .env (jamais commité) ou fournis ces variables à ton orchestrateur.
SUPABASE_URL=https://<ton-projet>.supabase.co
# Clé service_role : contourne la RLS. Serveur uniquement, ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=
# Même valeur que 'webhook_secret' dans private.app_config (voir supabase/config.example.sql)
WEBHOOK_SECRET=
PORT=8080
